# Copie para .env.production, fora do Git, e preencha antes do deploy.
RELEASE=candidate
APP_ORIGIN=https://galetobot.example.invalid
ADMIN_EMAIL=
ADMIN_PASSWORD=
WEBHOOK_TOKEN=

# Endereços privados explícitos, sem protocolo.
LAN_BIND_IP=
N8N_SOURCE_IP=
PUBLIC_LOOPBACK_PORT=8080
INTEGRATION_PORT=3001

DATABASE_DIR=./runtime/db
DATABASE_FILENAME=galetobot.db

# Preencha somente para a ativação autorizada do perfil whatsapp.
WHATSAPP_SESSION_DIR=./runtime/whatsapp-session
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
# Chat web opcional. Consulte docs/atendimento-web.md antes de habilitar.
CHAT_MODE=off
# CHAT_LAB_URL=
# CHAT_LAB_TOKEN=
# CHAT_HUMAN_CONTACT_URL=
