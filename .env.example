# Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ALTERAR_SENHA

# API
PORT=3000
# Demonstração usa 127.0.0.1 e operação usa 0.0.0.0 por padrão.
# HOST=127.0.0.1
# Opcional. Caminho absoluto ou relativo à raiz do repositório.
# DATABASE_PATH=apps/api/apps/api/data/galeto-dev.db
# Desenvolvimento usa .env.development e mantém o banco em apps/api/data/demo/.
# DEMO_DATABASE_PATH=apps/api/data/demo/galeto-demo.db
# Somente para criar um banco novo em desenvolvimento/teste.
# DATABASE_ALLOW_CREATE=1
APP_ORIGIN=http://localhost:5173

# Integrações
WEBHOOK_TOKEN=ALTERAR_TOKEN

# WhatsApp / n8n
N8N_WEBHOOK_URL=https://seu-n8n.example.com/webhook/galeto-mvp
N8N_WEBHOOK_TOKEN=ALTERAR_TOKEN_N8N
# Chat web opcional. Use demo apenas com banco e credenciais isolados.
CHAT_MODE=off
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_TOKEN=
# CHAT_LAB_URL=
# CHAT_LAB_TOKEN=
# CHAT_HUMAN_CONTACT_URL=
